# ─── NEWS API ──────────────────────────────────────────────────────
# Obtenha gratuitamente em: https://newsapi.org/register
NEWSAPI_KEY=sua_chave_aqui

# ─── CONFIGURAÇÃO DO DASHBOARD ─────────────────────────────────────
VITE_INSTAGRAM_HANDLE=cinex.goiania
